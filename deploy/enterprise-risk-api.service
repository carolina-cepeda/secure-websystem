[Unit]
Description=Enterprise Risk API
After=network.target

[Service]
User=riskapi
WorkingDirectory=/opt/enterprise-risk-api
Environment="APP_SECURITY_MODE=jwt"
Environment="AUTH0_ISSUER_URI=https://TU_TENANT.us.auth0.com/"
Environment="AUTH0_AUDIENCE=https://enterprise-risk-api"
Environment="APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,https://TU-SUBDOMAIN.duckdns.org"
ExecStart=/usr/bin/java -jar /opt/enterprise-risk-api/app.jar
Restart=always

[Install]
WantedBy=multi-user.target
